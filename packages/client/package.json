{
  "name": "@coresoft-hq/pi-daemon-client",
  "version": "1.0.0",
  "description": "TypeScript client for pi-daemon: pairing, the /v1 API, the event stream with resume, and terminal streams. Works in Node 22+ and browsers.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -b"
  },
  "peerDependencies": {
    "@coresoft-hq/pi-daemon-contract": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "@coresoft-hq/pi-daemon-contract": {
      "optional": true
    }
  },
  "devDependencies": {
    "@coresoft-hq/pi-daemon-contract": "1.0.0",
    "typebox": "^1.3.7"
  }
}
